---
layout: none
sitemap: false
permalink: sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

{% assign pages = pages | sort: 'url' -%}

{%- for page in pages -%}

{%- unless page.sitemap == false -%}
<url>
  <loc>{{ site.url | append: page.url | regex_replace: '/index(\.html)?$|\.html$|/$' }}</loc>
  <lastmod>
    {%- if page.sitemap.lastmod -%}
      {{ page.sitemap.lastmod | date: "%Y-%m-%d" }}
    {%- else -%}
      {{ site.now | default: page.date | default: site.time }}
    {%- endif -%}
  </lastmod>
  <changefreq>{{ page.sitemap.changefreq | default: 'monthly' }}</changefreq>
  {% if page.sitemap.priority -%}
  <priority>{{ page.sitemap.priority }}</priority>
  {%- endif -%}
</url>
{% endunless -%}

{%- endfor -%}
</urlset>
